# ==============================================================================
# AIOS — Enterprise Multi-Agent AI Platform
# Canonical Production Environment Configuration
# ==============================================================================

# ==============================================================================
# 1. BACKEND VARIABLES (Deploy to Render Web Service)
# ==============================================================================

# Core App Settings
PROJECT_NAME="AIOS - Enterprise Multi-Agent AI Platform"
ENVIRONMENT="production"            # development | production | testing
DEBUG=false
API_V1_STR="/api/v1"
PORT=8000                           # Render automatically populates $PORT
HOST="0.0.0.0"

# Security (JWT Authentication)
# Generate a secure 32+ character random secret for production: `openssl rand -hex 32`
SECRET_KEY="replace_with_a_secure_random_production_secret_key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440    # 24 hours

# Canonical Frontend & CORS Configuration
# Set to your canonical Vercel production domain and optional custom domain
FRONTEND_URL="https://your-aios-app.vercel.app"
BACKEND_CORS_ORIGINS="https://your-aios-app.vercel.app,http://localhost:5173"

# Relational Database (PostgreSQL Async)
# Local: "sqlite+aiosqlite:///./aios_dev.db"
# Render / Cloud PostgreSQL: "postgresql+asyncpg://user:password@host:port/dbname"
DATABASE_URL="postgresql+asyncpg://aios_user:aios_secure_pass_2026@localhost:5432/aios_db"

# Redis Cache & Background Tasks
# Render Redis: "redis://red-xxxx:6379" or internal hostname
REDIS_URL="redis://localhost:6379/0"

# Vector Database (Qdrant)
# Qdrant Cloud or self-hosted endpoint
QDRANT_HOST="localhost"
QDRANT_PORT=6333
QDRANT_API_KEY=""
QDRANT_URL=""

# Knowledge Graph (Neo4j)
# Neo4j Aura: "neo4j+s://xxxx.databases.neo4j.io"
# Local: "bolt://localhost:7687"
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="replace_with_neo4j_password"

# File & Document Storage (local | s3 | minio)
STORAGE_TYPE="local"
STORAGE_LOCAL_DIR="data/uploads"
MINIO_ENDPOINT="localhost:9000"
MINIO_ACCESS_KEY="aios_minio_admin"
MINIO_SECRET_KEY="replace_with_minio_secret"
MINIO_BUCKET_DOCUMENTS="aios-documents"

# AI Model Provider API Keys (Set keys for providers you wish to enable)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
GROQ_API_KEY=""
TOGETHER_API_KEY=""
OPENROUTER_API_KEY=""

# ==============================================================================
# 2. FRONTEND VARIABLES (Deploy to Vercel Project Settings)
# ==============================================================================
# In standard single-origin architecture:
# Keep VITE_API_URL empty! Vercel's vercel.json rewrite rule automatically proxies
# '/api/*' to your Render backend: https://your-backend.onrender.com/api/*
#
# If connecting directly to a remote backend without Vercel rewrites, set:
# VITE_API_URL="https://your-backend.onrender.com"
#
# If connecting directly to backend WebSockets:
# VITE_WS_URL="wss://your-backend.onrender.com"
VITE_API_URL=""
VITE_WS_URL=""
